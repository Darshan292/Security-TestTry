# Copy to .env (git-ignored) and fill in. Never commit .env.
#   cp .env.example .env && chmod 600 .env
# Values already exported in the shell, or set as Codespaces secrets, take precedence over this file.
GROQ_API_KEY=

# Production only: JSON map sanitizer ID -> random 32-byte-or-longer secret as hex. Never commit real keys.
PGW_SANITIZER_HMAC_KEYS={}
# Persistent nonce replay database; default is derived from PGW_LEDGER_DB.
PGW_ATTESTATION_DB_PATH=
