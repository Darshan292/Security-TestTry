# Python
__pycache__/
*.pyc
.venv/
venv/
.env
.env.*
!.env.example
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Never commit real HRIS/ERP data or keys
data/real/
*.pem
*.key
secrets/

# Generated eval corpus: reproducible from eval/synth/generate.py (hashes in MANIFEST.json);
# contains realistic fake secrets that trip secret scanners
eval/data/*.jsonl
# Release-2 corpus (v2): reproducible from eval/synth2/generate.py; hashes in eval/data2/MANIFEST.json
eval/data2/*.jsonl
eval/results/det_*.json
graph/cache/
graphify-out/
# Release-3 corpus (v3): dev splits reproducible from the sealed generators; test3 sealed
eval/data3/*.jsonl
eval/data3/v12_keys.json
eval/results/*_ckpt/
# R4 E-UTIL: regenerated by eval/eutil/build.py and run_eutil.py; contain synthetic fake identifiers
eval/eutil/*.jsonl
eval/eutil/out/*.jsonl
eval/eutil/out/restore_*.json
eval/eutil/.ext.json

# ML evaluation run log (release-gate runs; dataset hashes only, but kept out of git)
eval/ml/results/
